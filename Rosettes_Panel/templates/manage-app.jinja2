{% extends "layout.jinja2" %}
{% block title %}{{ app['name'] }}{% endblock %}

{% block main %}

    <a class="back-link" href="/panel/">Back to panel</a>

    <section class="page-head compact">
        <div class="page-copy">
            <h1>{{ app['name'] }}</h1>
            <p class="lead">Application details and authorized users.</p>
        </div>
        <form method="POST" action="/action/delete-app/{{ app['id'] }}"
              onsubmit="return confirm('Delete this application? This will also remove its user authorizations.');">
            {{ csrf_input()|safe }}
            <button type="submit" class="entry-remove">Delete application</button>
        </form>
    </section>

    <div class="stack">
        <div class="block">
            <div class="info-grid">
                <div>
                    <p class="muted">Application ID</p>
                    <p><strong>#{{ app['id'] }}</strong></p>
                </div>
                <div>
                    <p class="muted">Token</p>
                    {% if app['token_key'] %}
                        <p><code class="token">{{ app['token_key'] }}</code></p>
                        <p class="helper-text">This older token is visible here. Keep it private.</p>
                    {% else %}
                        <p class="helper-text">Hidden for your safety. Tokens are only shown when the app is created.</p>
                    {% endif %}
                </div>
            </div>
        </div>


        <div class="block">
            <h3>Authorized users</h3>
            <div class="inline-list spaced-list">
                {% for user in users %}
                    <div class="block soft">
                        <p><strong>{{ user['namecache'] }}</strong></p>
                        <p class="muted">Username: {{ user['username'] }}</p>
                        <p class="muted">User ID: {{ user['id'] }}</p>
                        <form method="POST" action="/action/revoke-app-user/{{ app['id'] }}/{{ user['id'] }}"
                              onsubmit="return confirm('Revoke this user authorization?');">
                            {{ csrf_input()|safe }}
                            <button type="submit" class="entry-remove">Revoke</button>
                        </form>
                    </div>
                {% else %}
                    <p class="muted">No user has yet approved your application for auth.</p>
                {% endfor %}
            </div>
        </div>

        <div class="block stack-tight">
            <h3>Application access</h3>
            <p class="helper-text">Apps can ask users for permission, check whether a user has approved access, and send Rosettes notifications to approved users.</p>
            <ul class="endpoint-list">
                <li><strong>Request access</strong> — Ask a user to approve your app.</li>
                <li><strong>Check approval</strong> — Confirm whether a user has approved your app.</li>
                <li><strong>Notify user</strong> — Send a Rosettes notification to an approved user.</li>
            </ul>
        </div>
    </div>
{% endblock %}
